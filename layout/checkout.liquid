    <!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ direction }}" class="{{ checkout_html_classes }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, user-scalable=0">
    <meta name="referrer" content="origin">

    <title>{{ page_title }}</title>

    {{ content_for_header }}

    {{ checkout_stylesheets }}
    {{ checkout_scripts }}
    <!-- <script src="https://cdn-widgetsrepository.yotpo.com/v1/loader/txSQJcNaCi_4i2NB6Qz14w" async></script> -->
      <script src="https://code.jquery.com/jquery-3.7.0.min.js" integrity="sha256-2Pmvv0kuTBOenSvLm6bvfBSSHrUJ+3A7x6P5Ebd07/g=" crossorigin="anonymous"></script>
      <script src="https://cdn.intelligems.io/64582baee93f.js"></script>
  </head>
  <body>
    {{ skip_to_content_link }}

    <header class="banner" data-header role="banner">
      <div class="wrap">
        {{ content_for_logo }}
      </div>
    </header>

    {{ order_summary_toggle }}
    <div class="content" data-content>
      <div class="wrap">
        <div class="main">
          <header class="main__header" role="banner">
            {{ content_for_logo }}
            {{ breadcrumb }}
            {{ alternative_payment_methods }}
          </header>
          <main class="main__content" role="main">
            <button class="discount-btn" data-discount-btn>
              Have a discount code? <span>Click here to enter</span>
            </button>
            <style>
              .discount-btn {
                margin: 0 0 20px;
                width: 100%;
                border: 1px solid #d9d9d9;
                border-radius: 5px;
                padding-top: 0.8571428571em;
                padding-bottom: 0.8571428571em;
              }

              .discount-btn span:first-child {
                color: black;
              }

              .discount-btn span:last-child {
                text-underline-offset: 5px;
                text-decoration: underline;
              }

              @media (min-width: 1000px) {
                .discount-btn {
                  display: none;
                }
              }
            </style>
            <script>
              $(document).ready(function() {
                var $orderSummaryToggle = $('.order-summary-toggle');
                var $orderSummary = $('[data-order-summary]');
                var $discountBtn = $('[data-discount-btn]');

                $orderSummaryToggle.on('click', function() {
                  $orderSummary.toggleClass('order-summary--is-collapsed');
                });
                
                $discountBtn.on('click', function() {
                  $orderSummary.toggleClass('order-summary--is-collapsed');
                });
                
                $(document).on("page:load page:change", function(e) {
                  checkTags();
                });

                checkTags();

                function checkTags() {
                  var $tagList = $('.tags-list');
                  
                  if ($tagList.length > 0) {
                    $discountBtn.attr('hidden', 'true');
                  } else {
                    $discountBtn.removeAttr('hidden');
                  }
                }
              });
            </script>
            {{ content_for_layout }}
          </main>
          <footer class="main__footer" role="contentinfo">
            {{ content_for_footer }}
          </footer>
        </div>
        <aside class="sidebar" role="complementary">
          <div class="sidebar__header">
            {{ content_for_logo }}
          </div>
          <div class="sidebar__content">
            {{ content_for_order_summary }}
          </div>
        </aside>
      </div>
    	<div class="yotpo-widget-instance" data-yotpo-instance-id="65717"></div>
    </div>
    
	
    {{ tracking_code }}

    <!-- Capsule Offer -->
    {%- assign capsule_in_cart = checkout.line_items | where: 'variant_id', 41509856379053 -%}
    {%- if capsule_in_cart.size == 0 -%}
      <script>
        (function($) {
          $(document).on("page:load page:change", function() {
            var validCodes  = ['SUBSCRIBEFLASH'];
            var code = $('.reduction-code__text').first().text();
  
            if (code == '') return;
  
            if (validCodes.includes(code)) {
              $.ajax({
                type: 'POST',
                url: '/cart/add.js',
                data: {
                  quantity: 1,
                  id: 41509856379053
                },
                dataType: 'json', 
                success: function (data) { 
                  location.reload();
                } 
              });
            }
          });
        })(Checkout.$);
      </script>
    {%- endif -%}
    <!-- End Capsule Offer -->
    
    <!-- Chewable Offer -->
    {%- assign chewable_in_cart = checkout.line_items | where: 'variant_id', 41905319346349 -%}
    {%- if chewable_in_cart.size == 0 -%}
      <script>
        (function($) {
          $(document).on("page:load page:change", function() {
            var validCodes = ['CALM25', 'FALLSALE30']
            var code = $('.reduction-code__text').first().text();
  
            if (code == '') return;
  
            if (validCodes.includes(code)) {
              $.ajax({
                type: 'POST',
                url: '/cart/add.js',
                data: {
                  quantity: 1,
                  id: 41905319346349
                },
                dataType: 'json', 
                success: function (data) { 
                  location.reload();
                } 
              });
            }
          });
        })(Checkout.$);
      </script>
    {%- endif -%}
    <!-- End Chewable Offer -->
    <!-- Guarantee badge -->
      {% assign includes_subscription = false %}
      {% for line_item in checkout.line_items %}
        {% if line_item.selling_plan_allocation.selling_plan.name != blank %}
          {% assign includes_subscription = true %}
        {% endif %}
      {% endfor %}
    {% if includes_subscription %}
      <script>
        var orderSummary = document.querySelector('.order-summary__sections');
        var guaranteeBadge = '<a href="/policies/order-info" target="_blank" style="display: flex; align-items: center; text-decoration: underline;"><img src="https://cdn.shopify.com/s/files/1/0571/6977/2717/files/30-day-money-back.png?v=1708536405" style="width: 90px; margin-right: 20px;"><span>Subscription Policy</span></a>';
        orderSummary.innerHTML = orderSummary.innerHTML + guaranteeBadge;
      </script>
    {% else %}
      <script>
        var orderSummary = document.querySelector('.order-summary__sections');
        var guaranteeBadge = '<a href="/policies/order-info" target="_blank" style="text-decoration: underline;"><img src="https://cdn.shopify.com/s/files/1/0571/6977/2717/files/30-day-money-back.png?v=1708536405" style="width: 90px;"></a>';
        orderSummary.innerHTML = orderSummary.innerHTML + guaranteeBadge;
      </script>
    {% endif %}
    <!-- End guarantee badge -->
  </body>

  <script type="text/javascript">usi_installed = 0; USI_installCode = function() { if (usi_installed == 0) { usi_installed = 1; var USI_headID = document.getElementsByTagName("head")[0]; var USI_installID = document.createElement('script'); USI_installID.type = 'text/javascript'; USI_installID.src = 'https://www.upsellit.com/active/nextevo.jsp'; USI_headID.appendChild(USI_installID); } }; if (typeof(document.readyState) != "undefined" && document.readyState === "complete") { USI_installCode(); } else if (window.addEventListener){ window.addEventListener('load', USI_installCode, true); } else if (window.attachEvent) { window.attachEvent('onload', USI_installCode); } else { USI_installCode(); } setTimeout("USI_installCode()", 10000);</script>
  
</html>
 