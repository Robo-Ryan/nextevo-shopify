<div id="section--{{ section.id }}" class="how-to-take">
  <div class="page-width">
    <div class="section-header text-center">
    {%- if section.settings.title != blank or section.settings.text != blank -%}
      {% if section.settings.title != blank %}
       <h2>{{ section.settings.title | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
      <div class="rte">
        {{ section.settings.text }}
      </div>
      {% endif %}
    {%- endif -%}
    </div>
    <div class="how-to-take--chart">
      <div class="chart-row label-row">
        {% for n in (1..3) %}
         {% assign chart_label = "label_" | append: n %}
         {% assign chart_label = section.settings[chart_label] | default: false %}
         {% if chart_label contains 'TM' %}
          {% assign chart_label =  chart_label | split: 'TM' %}
          <div class="chart-label">{{ chart_label[0] }}<span class="trademark">TM</span> {{ chart_label[1] }}</div>
         {% else %}
           <div class="chart-label">{{ chart_label }}</div>
         {% endif %}
        {% endfor %}
      </div>
      {% for n in (1..3) %}
      <div class="chart-row item-row">
         {% assign level = "level_" | append: n %}
         {% assign level = section.settings[level] | default: false %}

         {% assign amount = "amount_" | append: n %}
         {% assign amount = section.settings[amount] | default: false %}

         {% assign standard_amount = "standard_amount_" | append: n %}
         {% assign standard_amount = section.settings[standard_amount] | default: false %}

         <div class="chart-item">{{ level }}</div>
         <div class="chart-item">{{ amount }}</div>
         <div class="chart-item">{{ standard_amount }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
  #section--{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.color }};
  }
  #section--{{ section.id }} h2 {
    color: {{ section.settings.color }};
  }
  @media only screen and (max-width: 768px) {
  #shopify-section-{{ section.id }}  {
    margin-top: {{ section.settings.margin_top | times: 0.6 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.6 }}px;
  }
</style>

{% schema %}
  {
    "name": "How to take",
    "settings": [
     {
        "type": "range",
        "id": "margin_top",
        "label": "Margin top",
        "default": 0,
        "min": 0,
        "max": 150,
        "step": 5,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "label": "Margin bottom",
        "default": 0,
        "min": 0,
        "max": 150,
        "step": 5,
        "unit": "px"
      },
     {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#F5F6FB"
     },
     {
        "type": "color",
        "id": "color",
        "label": "Text color",
        "default": "#002D72"
      },
     {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Rich text"
      },
      {
        "id": "text",
        "type": "richtext",
        "label": "Text",
        "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
      },
      {
        "type": "header",
        "content": "Column #1"
      },
      {
        "type": "text",
        "id": "label_1",
        "label": "Heading",
        "default": "Experience Level"
      },
      {
        "type": "text",
        "id": "level_1",
        "label": "Level #1",
        "default": "Beginner"
      },
      {
        "type": "text",
        "id": "level_2",
        "label": "Level #2",
        "default": "Intermediate"
      },
      {
        "type": "text",
        "id": "level_3",
        "label": "Level #3",
        "default": "Expert"
      },
      {
        "type": "header",
        "content": "Column #2"
      },
      {
        "type": "text",
        "id": "label_2",
        "label": "Heading",
        "default": "SmartsorbTM CBD"
      },
      {
        "type": "text",
        "id": "amount_1",
        "label": "Amount #1",
        "default": "10 mg"
      },
      {
        "type": "text",
        "id": "amount_2",
        "label": "Amount #2",
        "default": "20 mg"
      },
      {
        "type": "text",
        "id": "amount_3",
        "label": "Amount #3",
        "default": "40 mg"
      },
      {
        "type": "header",
        "content": "Column #3"
      },
      {
        "type": "text",
        "id": "label_3",
        "label": "Heading",
        "default": "Standard CBD Oil"
      },
      {
        "type": "text",
        "id": "standard_amount_1",
        "label": "Amount #1",
        "default": "40 mg"
      },
      {
        "type": "text",
        "id": "standard_amount_2",
        "label": "Amount #2",
        "default": "80 mg"
      },
      {
        "type": "text",
        "id": "standard_amount_3",
        "label": "Amount #3",
        "default": "160 mg"
      }
    ],
     "presets": [
      {
        "name": "How to take"
      }
    ]
  }
{% endschema %}
