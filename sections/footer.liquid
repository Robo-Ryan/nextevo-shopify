        "name": "Icons",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon_1",
            "label": "Icon #1"
          },
          {
            "type": "image_picker",
            "id": "icon_2",
            "label": "Icon #2"
          },
          {
            "type": "image_picker",
            "id": "icon_3",
            "label": "Icon #3"
          },
          {
            "type": "image_picker",
            "id": "icon_4",
            "label": "Icon #4"
          },
          {
            "type": "image_picker",
            "id": "icon_5",
            "label": "Icon #5"
          }
        ]
      },
      {
        "type": "instafeed",
        "name": "Instagram",
        "settings": [
          {
            "type": "text",
