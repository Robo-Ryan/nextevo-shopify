<div
  data-section-id="{{ section.id }}"
  data-section-type="hero-section"
  {% if section.settings.parallax %}data-parallax="true"{% endif %}>

 
    <div class="slideshow-wrapper">

      {%- assign natural_height = false -%}
      {%- assign natural_mobile_height = false -%}
      {%- if section.settings.section_height == 'natural' or section.settings.mobile_height == 'auto' -%}
        {% comment %}
          Get first image's aspect ratio
        {% endcomment %}
          {%- if section.settings.image != blank -%}
            {%- if section.settings.section_height == 'natural' %}
              {%- assign natural_height = true -%}
              {%- capture natural_height_ratio -%}{{ 100 | divided_by: section.settings.image.aspect_ratio }}%{% endcapture %}
            {%- endif -%}
          {%- endif -%}
          {%- if section.settings.image_mobile != blank -%}
            {%- if section.settings.mobile_height == 'auto' -%}
              {%- assign natural_mobile_height = true -%}
              {%- capture natural_mobile_height_ratio -%}{{ 100 | divided_by: section.settings.image_mobile.aspect_ratio }}%{% endcapture %}
            {%- endif -%}
          {%- endif -%}
      {%- endif -%}

      {%- if natural_height -%}
        {%- style -%}
          @media only screen and (min-width: 769px) {
            .hero-natural--{{ section.id }} {
              height: 0;
              padding-bottom: {{ natural_height_ratio }};
            }
          }
        {%- endstyle -%}
      {%- endif -%}
      {%- if natural_mobile_height -%}
        {%- style -%}
          @media screen and (max-width: 768px) {
            .hero-natural-mobile--{{ section.id }} {
              height: 0;
              padding-bottom: {{ natural_mobile_height_ratio }};
            }
          }
        {%- endstyle -%}
      {%- endif -%}

      <div class="{% if natural_height %}hero-natural--{{ section.id }}{% endif %}{% if natural_mobile_height %} hero-natural-mobile--{{ section.id }}{% endif %}">
        <div id="Slideshow-{{ section.id }}"
          class="hero hero--{{ section.settings.section_height }} hero--{{ section.id }} hero--mobile--{{ section.settings.mobile_height }}"
          {% if natural_height %}
            data-natural="true"
          {% endif %}
          data-mobile-natural="{{ natural_mobile_height }}">
            <div
              class="hero__slide slideshow__slide--{{ section.id }}"
              data-id="{{ section.id }}">

              {%- style -%}
                .slideshow__slide--{{ section.id }} .hero__title {
                  font-size: {{ section.settings.title_size | times: 0.8 }}px;
                  font-weight: {{ section.settings.title_weight }};
                  color: {{ section.settings.title_color }};
                  letter-spacing: {{ section.settings.title_spacing | divided_by: 100 }}em;
                }
                .slideshow__slide--{{ section.id }} .hero__subtitle {
                  font-size: {{ section.settings.subheading_size | times: 1 }}px;
                  font-weight: {{ section.settings.subheading_weight }}!important;
                  color: {{ section.settings.subheading_color }};
                  letter-spacing: {{ section.settings.subheading_spacing | divided_by: 100 }}em;
                }
                  .slideshow__slide--{{ section.id }} .hero__text-shadow {
                    max-width: {{ section.settings.mobile_caption_width }}px;
                  }
                @media only screen and (min-width: 769px) {
                  .slideshow__slide--{{ section.id }} .hero__text-shadow {
                    max-width: {{ section.settings.caption_width }}px;
                  }
                  .slideshow__slide--{{ section.id }} .hero__title {
                    font-size: {{ section.settings.title_size }}px;
                  }
                 .slideshow__slide--{{ section.id }} .hero__subtitle {
                    font-size: {{ section.settings.subheading_size }}px;
                  }
                }

                {%- assign button_alpha = section.settings.color_accent | color_extract: 'alpha' -%}
                {% unless button_alpha == 0.0 %}
                  .slideshow__slide--{{ section.id }} .btn {
                    background: {{ section.settings.color_accent }} !important;
                    border: none;

                    {%- assign accent_brightness = section.settings.color_accent | color_extract: 'lightness' -%}

                    {% if accent_brightness > 40 %}
                      color: #000 !important;
                    {% endif %}
                  }

                  {% if settings.button_style == 'angled' %}
                    .slideshow__slide--{{ section.id }} .btn:before,
                    .slideshow__slide--{{ section.id }} .btn:after {
                      background: {{ section.settings.color_accent }} !important;
                      border: none;
                    }
                  {% endif %}
                {% endunless %}

                {% if section.settings.overlay_opacity > 0 %}
                  .slideshow__slide--{{ section.id }} .hero__image-wrapper:after {
                    content: '';
                    position: absolute;
                    left: 0;
                    right: 0;
                    top: 0;
                    bottom: 0;
                    z-index: 3;
                    background-color: #000;
                    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
                  }
                {% endif %}
              {%- endstyle -%}

              {%- liquid
                assign hero_text = false
                assign link_slide = false
                if section.settings.top_subheading != blank or section.settings.title != blank or section.settings.subheading != blank or section.settings.link_text != blank
                  assign hero_text = true
                endif
                if section.settings.link != blank and section.settings.link_2 == blank
                  assign link_slide = true
                endif

                assign has_mobile_image = false
                if section.settings.image_mobile != blank
                  assign has_mobile_image = true
                endif
              -%}

              <div class="hero__image-wrapper{% unless hero_text %} hero__image-wrapper--no-overlay{% endunless %}">

                {%- if section.settings.parallax -%}
                  <div class="parallax-container">
                    <div class="parallax-image">
                {%- endif -%}

                  {%- if section.settings.image != blank -%}
                    {%- assign img_url = section.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}

                    <img class="hero__image hero__image--{{ section.id }} lazyload{% if has_mobile_image %} small--hide{% endif %}"
                      src="{{ section.settings.image | img_url: '300x' }}"
                      data-src="{{ img_url }}"
                      data-aspectratio="{{ section.settings.image.aspect_ratio }}"
                      data-sizes="auto"
                      alt="{{ section.settings.image.alt | escape }}"
                      style="object-position: {{ section.settings.focal_point }}">
                    {%- if has_mobile_image -%}
                      {%- assign img_url_mobile = section.settings.image_mobile | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
                      <img class="hero__image hero__image--{{ section.id }} lazyload medium-up--hide"
                        src="{{ section.settings.image_mobile | img_url: '300x' }}"
                        data-src="{{ img_url_mobile }}"
                        data-aspectratio="{{ section.settings.image_mobile.aspect_ratio }}"
                        data-sizes="auto"
                        alt="{{ section.settings.image_mobile.alt | escape }}"
                        style="object-position: {{ section.settings.focal_point }}">
                    {%- endif -%}
                    <noscript>
                      <img class="hero__image hero__image--{{ section.id }}"
                        src="{{ section.settings.image | img_url: '1400x' }}"
                        alt="{{ section.settings.image.alt | escape }}">
                    </noscript>
                  {%- else -%}
                    {%- if template == 'password' -%}
                      {%- assign password_image = 'password-page-background.jpg' | asset_url -%}
                      <img class="hero__image lazyload" src="{{ password_image }}">
                    {%- else -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  {%- endif -%}

                {%- if section.settings.parallax -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>

              {%- if link_slide -%}
                <a href="{{ section.settings.link }}" class="hero__slide-link" aria-hidden="true"></a>
              {%- endif -%}

              {%- if hero_text -%}
                <div class="hero__text-wrap">
                  <div class="page-width">
                    <div class="hero__text-content {{ section.settings.text_align }} {{ section.settings.mobile_text_align }}">
                      <div class="hero__text-shadow">
                        {%- unless section.settings.top_subheading == blank -%}
                          <div class="hero__top-subtitle">
                            <div class="animation-cropper"><div class="animation-contents">
                              {{ section.settings.top_subheading }}
                            </div></div>
                          </div>
                        {%- endunless -%}
                        {%- unless section.settings.title == blank -%}
                          {% if section.settings.h1 %}
                            <h1 class="h1 hero__title">
                              <div class="animation-cropper"><div class="animation-contents">
                              {{ section.settings.title | newline_to_br }}
                              </div></div>
                            </h1>
                          {% else %}
                            <h2 class="h1 hero__title">
                              <div class="animation-cropper"><div class="animation-contents">
                              {{ section.settings.title | newline_to_br }}
                              </div></div>
                            </h2>
                          {% endif %}
                        {%- endunless -%}
                        {%- if section.settings.subheading or section.settings.link or section.settings.link_2 -%}
                          {%- unless section.settings.subheading == blank -%}
                            <div class="hero__subtitle">
                              <div class="animation-cropper"><div class="animation-contents">
                                {{ section.settings.subheading }}
                              </div></div>
                            </div>
                          {%- endunless -%}
                          {%- if section.settings.link_text != blank or section.settings.link_text_2 != blank -%}
                            <div class="hero__link">
                              {%- if section.settings.link_text != blank -%}
                                <a href="{{ section.settings.link }}" class="btn{% if section.settings.color_accent contains 'rgba(0,0,0,0)' %} btn--inverse{% endif %}">
                                  {{ section.settings.link_text }}
                                </a>
                              {%- endif -%}
                              {%- if section.settings.link_text_2 != blank -%}
                                <a href="{{ section.settings.link_2 }}" class="btn{% if section.settings.color_accent contains 'rgba(0,0,0,0)' %} btn--inverse{% endif %}">
                                  {{ section.settings.link_text_2 }}
                                </a>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </div>
        </div>
      </div>
    </div>

</div>

{% schema %}
  {
    "name": "Hero image",
    "class": "index-section--hero",
    "settings": [
      {
        "type": "select",
        "id": "section_height",
        "label": "Desktop height",
        "default": "650px",
        "options": [
          {
            "label": "Natural",
            "value": "natural"
          },
          {
            "label": "450px",
            "value": "450px"
          },
          {
            "label": "550px",
            "value": "550px"
          },
          {
            "label": "650px",
            "value": "650px"
          },
          {
            "label": "750px",
            "value": "750px"
          },
          {
            "label": "Full screen",
            "value": "100vh"
          }
        ]
      },
      {
        "type": "select",
        "id": "mobile_height",
        "label": "Mobile height",
        "default": "auto",
        "options": [
          {
            "label": "Auto",
            "value": "auto"
          },
          {
            "label": "250px",
            "value": "250px"
          },
          {
            "label": "300px",
            "value": "300px"
          },
          {
            "label": "400px",
            "value": "400px"
          },
          {
            "label": "500px",
            "value": "500px"
          },
          {
            "label": "Full screen",
            "value": "100vh"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "parallax",
        "label": "Enable parallax",
        "default": true
      },
      {
            "type": "header",
            "content": "Image settings"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "Mobile image"
          },
          {
            "type": "range",
            "id": "overlay_opacity",
            "label": "Text protection",
            "info": "Darkens your image to ensure your text is readable",
            "default": 0,
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "%"
          },
          {
            "type": "select",
            "id": "focal_point",
            "label": "Image focal point",
            "info": "Used to keep the subject of your photo in view.",
            "default": "center center",
            "options": [
              {
                "value": "20% 0",
                "label": "Top left"
              },
              {
                "value": "top center",
                "label": "Top center"
              },
              {
                "value": "80% 0",
                "label": "Top right"
              },
              {
                "value": "20% 50%",
                "label": "Left"
              },
              {
                "value": "center center",
                "label": "Center"
              },
              {
                "value": "80% 50%",
                "label": "Right"
              },
              {
                "value": "20% 100%",
                "label": "Bottom left"
              },
              {
                "value": "bottom center",
                "label": "Bottom center"
              },
              {
                "value": "80% 100%",
                "label": "Bottom right"
              }
            ]
          },
          {
            "type": "header",
            "content": "Caption settings"
          },
          {
            "type": "range",
            "id": "caption_width",
            "label": "Caption max-width",
            "default": 800,
            "min": 200,
            "max": 1000,
            "step": 50,
            "unit": "px"
          },
          {
            "type": "range",
            "id": "mobile_caption_width",
            "label": "Caption mobile max-width",
            "default": 700,
            "min": 100,
            "max": 700,
            "step": 20,
            "unit": "px"
          },
          {
            "type": "select",
            "id": "text_align",
            "label": "Text alignment",
            "default": "vertical-center horizontal-center",
            "options": [
              {
                "value": "vertical-top horizontal-left",
                "label": "Top left"
              },
              {
                "value": "vertical-top horizontal-center",
                "label": "Top center"
              },
              {
                "value": "vertical-top horizontal-right",
                "label": "Top right"
              },
              {
                "value": "vertical-center horizontal-left",
                "label": "Center left"
              },
              {
                "value": "vertical-center horizontal-center",
                "label": "Center"
              },
              {
                "value": "vertical-center horizontal-right",
                "label": "Center right"
              },
              {
                "value": "vertical-bottom horizontal-left",
                "label": "Bottom left"
              },
              {
                "value": "vertical-bottom horizontal-center",
                "label": "Bottom center"
              },
              {
                "value": "vertical-bottom horizontal-right",
                "label": "Bottom right"
              }
            ]
          },
          {
            "type": "select",
            "id": "mobile_text_align",
            "label": "Mobile text alignment",
            "default": "m-vertical-center m-horizontal-left",
            "options": [
              {
                "value": "m-vertical-top m-horizontal-left",
                "label": "Top left"
              },
              {
                "value": "m-vertical-top m-horizontal-center",
                "label": "Top center"
              },
              {
                "value": "m-vertical-top m-horizontal-right",
                "label": "Top right"
              },
              {
                "value": "m-vertical-center m-horizontal-left",
                "label": "Center left"
              },
              {
                "value": "m-vertical-center m-horizontal-center",
                "label": "Center"
              },
              {
                "value": "m-vertical-center m-horizontal-right",
                "label": "Center right"
              },
              {
                "value": "m-vertical-bottom m-horizontal-left",
                "label": "Bottom left"
              },
              {
                "value": "m-vertical-bottom m-horizontal-center",
                "label": "Bottom center"
              },
              {
                "value": "m-vertical-bottom m-horizontal-right",
                "label": "Bottom right"
              }
            ]
          },
          {
            "type": "header",
            "content": "Text settings"
          },
          {
            "type": "text",
            "id": "top_subheading",
            "label": "Subheading"
          },
          {
            "type": "textarea",
            "id": "title",
            "label": "Heading",
            "default": "Two line\ntitle slide."
          },
          {
            "type": "checkbox",
            "id": "h1",
            "label": "Make heading H1 tag"
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "Heading color",
            "default": "#fff"
          },
          {
            "type": "range",
            "id": "title_size",
            "label": "Heading text size",
            "default": 80,
            "min": 40,
            "max": 100,
            "unit": "px"
          },
          {
            "type": "range",
            "id": "title_spacing",
            "label": "Heading letter spacing",
            "default": 0,
            "min": 0,
            "max": 20,
            "unit": "em",
            "info": "10 will be a value of 0.1em"
          },
          {
            "type": "select",
            "id": "title_weight",
            "label": "Heading font weight",
            "options": [
              {
                "value": "normal",
                "label": "Normal"
              },
              {
                "value": "bold",
                "label": "Bold"
              }
            ],
            "default": "normal"
          },
          {
            "type": "richtext",
            "id": "subheading",
            "label": "Text"
          },
          {
            "type": "color",
            "id": "subheading_color",
            "label": "Text color",
            "default": "#fff"
          },
          {
            "type": "range",
            "id": "subheading_size",
            "label": "Text size",
            "default": 16,
            "min": 10,
            "max": 40,
            "unit": "px"
          },
          {
            "type": "range",
            "id": "subheading_spacing",
            "label": "Text letter spacing",
            "default": 0,
            "min": 0,
            "max": 20,
            "unit": "em",
            "info": "10 will be a value of 0.1em"
          },
          {
            "type": "select",
            "id": "subheading_weight",
            "label": "Text font weight",
            "options": [
              {
                "value": "normal",
                "label": "Normal"
              },
              {
                "value": "bold",
                "label": "Bold"
              }
            ],
            "default": "normal"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Slide link"
          },
          {
            "type": "text",
            "id": "link_text",
            "label": "Slide link text",
            "default": "Optional button"
          },
          {
            "type": "url",
            "id": "link_2",
            "label": "Slide link 2"
          },
          {
            "type": "text",
            "id": "link_text_2",
            "label": "Slide link text 2"
          },
          {
            "type": "color",
            "id": "color_accent",
            "label": "Buttons",
            "default": "rgba(0,0,0,0)"
          }
    ],
    "presets": [{
      "name": "Hero image",
      "settings": {
       "title": "Endless\npossibilities.",
       "subheading": "<p>Bring your brand to life</p>"
      }
    }]
  }
{% endschema %}
