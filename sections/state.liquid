</div>

{% schema %}
{
  "name": "Custom Map",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Custom Map"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "This is a custom map section."
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top Margin",
      "default": 20,
      "min": 0,
      "max": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom Margin",
      "default": 20,
      "min": 0,
      "max": 100,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "map_point",
      "name": "Map Point",
      "settings": [
        {
          "type": "text",
          "id": "state",
          "label": "State"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Map",
      "category": "Custom"
    }
  ]
}
{% endschema %}
