{% style %}
#shopify-section-{{ section.id }} {
  margin-top: {{ section.settings.margin_top }}px;
  margin-bottom: {{ section.settings.margin_bottom }}px;
}
@media only screen and (max-width: 768px) {
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top | times: 0.6 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.6 }}px;
  }
}
.interactive-map path {
  stroke: #002D72;
  fill: #D1E5E7;

  transition: fill .4s ease;
  transform-origin: center center;
}

.interactive-map path:hover {
  fill: var(--hover-color)!important;
  cursor: pointer;
  transform: scale(1.005, 1.005);
}
.interactive-map #us-map {
  display: block;
  position: relative;
  margin: 0 auto;
  max-width: 100%;
  height: auto;
}

.interactive-map #details-box {
  opacity: 0%;
  padding: 5px 10px;
  position: fixed;
  color: #000;
  background-color: #fff;
  border: 1px solid #002D72;
  text-align: left;
  font-size: 13px;
  width: fit-content;
  max-width: 155px;
  transform: translateX(-50%);
  transition: opacity .4s ease;
  z-index: 1;
}
.interactive-map #details-box h6 {
  font-size: 14px;
  text-transform: unset;
  letter-spacing: 0;
  margin-bottom: 0;
}
.interactive-map .map-legend h3 {
  font-size: 40px;
  color: #4057A2;
  margin-bottom: 30px;
} 
.interactive-map .key {
  display: inline-flex;
  margin-right: 20px;
  margin-bottom: 30px;
  max-width: 220px;
}
.interactive-map .key-marker {
  min-width: 45px;
  min-height: 45px;
  width: 45px;
  height: 45px;
  margin-right: 10px;
}
@media only screen and (max-width: 768px) {
  .interactive-map .map-legend h3 {
    font-size: 28px;
  } 
  .interactive-map .key-marker {
    min-width: 30px;
    min-height: 30px;
    width: 30px;
    height: 30px;
  }
  .interactive-map .key {
    margin-right: 10px;
    max-width: calc(50% - 20px);
    font-size: calc(var(--typeBaseSize)*.75);
  }
}
{% endstyle %}

<div class="page-width">

  {%- if section.settings.title != blank or section.settings.text != blank -%}
    <div class="section-header text-{{ section.settings.align_text }}">
      {% if section.settings.title != blank %}
        <h2>{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="rte text-{{ section.settings.align_text }}">
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>
  {%- endif -%}
  
