<ul class="footer-icons">
  {% for n in (1..5) %}
   {% assign icon = "icon_" | append: n %}
   {% assign icon = block.settings[icon] | default: false %}
   {% if icon %}
    <li>
      {%- assign img_url = icon | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
      <img class="lazyload"
          data-src="{{ img_url }}"
          data-widths="[180, 360, 540, 720]"
          data-aspectratio="{{ icon.aspect_ratio }}"
          data-sizes="auto"
          alt="{{ icon.alt | default: 'NextEvo Instagram' }}">
      <noscript>
        <img class="lazyloaded" src="{{ icon | img_url: '400x' }}" alt="{{ icon.alt }}">
      </noscript>
    </li>
   {% endif %}
  {% endfor %}
</ul>